<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="SolidWorks.EPDM.Interop.epdm" Version="32.1.0" GeneratePathProperty="true" ExcludeAssets="all" />
    <ProjectReference Include="../Ragtime.SolidWorks.Core/Ragtime.SolidWorks.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="EPDM.Interop.epdm">
      <HintPath>$(PkgSolidWorks_EPDM_Interop_epdm)/lib/netstandard2.0/EPDM.Interop.epdm.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
